### 4. Call the endpoint from the Hint button

In [`static/js/guess_map.js`](\wsl.localhost\Ubuntu\home\spambuddy\cscc09\project-geoguesser\static\js\guess_map.js), add:

```js
const hintButton = document.querySelector("#hintButton");
const hintMessage = document.querySelector("#hintMessage");
const hintText = document.querySelector("#hintText");

hintButton.addEventListener("click", async () => {
  if (!gameplayEnabled) {
    return;
  }

  const imageId = window.currentStreetviewImageId;

  if (!imageId) {
    hintText.textContent = "No streetview image is loaded yet.";
    hintMessage.classList.remove("hidden");
    return;
  }

  hintButton.disabled = true;
  hintButton.textContent = "Generating hint...";
  hintText.textContent = "";
  hintMessage.classList.remove("hidden");

  try {
    const response = await fetch("/streetview/ai-review", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ imageId: String(imageId) }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Unable to generate hint.");
    }

    hintText.textContent = data.hint;
  } catch (error) {
    hintText.textContent = error.message;
  } finally {
    hintButton.disabled = false;
    hintButton.textContent = "Get Hint";
  }
});
```

One important detail: your current code sends `window.imageId`, but [`static/js/streetview.js`](./static/js/streetview.js) appears to set:

```js
window.currentStreetviewImageId = String(randomLocationImageId);
```

So the hint code should use:

```js
window.currentStreetviewImageId;
```

rather than:

```js
window.imageId;
```

You can keep the endpoint named `/ai-review` for now, or rename it to `/ai-hint` later for clarity.
