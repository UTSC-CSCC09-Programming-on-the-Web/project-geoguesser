No. In this middleware, `user` is the decoded JWT payload, not the record from your `Users` table.

You can fetch the real database user after verifying the token and attach that record to `req.user`:

```js
import jwt from "jsonwebtoken";
import { Users } from "../database/models/users.js";

export const authenticateToken = async (req, res, next) => {
  const token = req.cookies.token;

  if (!token) {
    return res.status(401).json({ message: "Unauthorized" });
  }

  try {
    const payload = jwt.verify(token, JWT_SECRET);

    const user = await Users.findByPk(payload.userId);

    if (!user) {
      return res.status(401).json({ message: "User no longer exists" });
    }

    req.user = user;
    next();
  } catch (error) {
    return res.status(403).json({ message: "Invalid or expired token" });
  }
};
```

Then create the JWT using `userId` instead of `id`:

```js
const token = jwt.sign(
  {
    userId: user.userId,
  },
  JWT_SECRET,
  { expiresIn: "1h" }
);
```

Your route can then use the actual Sequelize user object consistently:

```js
gameRouter.post("/start", authenticateToken, async (req, res) => {
  const userId = req.user.userId;

  console.log(req.user); // Actual Users table record

  // Game logic...
});
```

