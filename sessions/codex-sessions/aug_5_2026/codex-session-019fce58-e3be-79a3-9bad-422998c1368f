### 2. Move the Street View container into the results screen

In `guess_map.js`, add functions like:

```js
function showReviewStreetview() {
  const streetviewContainer = document.querySelector("#streetview-container");
  const reviewSlot = document.querySelector("#review-streetview-slot");

  if (streetviewContainer && reviewSlot) {
    reviewSlot.appendChild(streetviewContainer);

    requestAnimationFrame(() => {
      if (streetviewViewer?.resize) {
        streetviewViewer.resize();
      }
    });
  }
}

function restoreGameStreetview() {
  const streetviewContainer = document.querySelector("#streetview-container");
  const mapContainer = document.querySelector("#mapContainer");

  if (streetviewContainer && mapContainer) {
    mapContainer.appendChild(streetviewContainer);

    requestAnimationFrame(() => {
      if (streetviewViewer?.resize) {
        streetviewViewer.resize();
      }
    });
  }
}
```

The `streetviewViewer` variable is currently declared in `main.js`. If it is not globally accessible, expose it through `window`, for example:

```js
window.streetviewViewer = streetviewViewer;
```

Then reference `window.streetviewViewer` from `guess_map.js`.

Call:

```js
showReviewStreetview();
```

immediately before:

```js
gameLayoutInvisible(true);
```

inside `submitGuess()`.

When starting the next round, call:

```js
restoreGameStreetview();
```

before loading the next image.

### 3. Update the AI-review handler

The current handler only logs the AI response:

```js
console.log(aiReview.text);
```

Replace that behavior with UI updates:

```js
const aiReviewButton = document.querySelector("#aiReviewButton");
const aiReviewStatus = document.querySelector("#aiReviewStatus");
const aiReviewText = document.querySelector("#aiReviewText");

aiReviewButton.addEventListener("click", async () => {
  if (!window.imageId) {
    aiReviewStatus.textContent = "No Street View image is available.";
    return;
  }

  aiReviewButton.disabled = true;
  aiReviewStatus.textContent = "Analyzing the image...";
  aiReviewText.textContent = "";

  try {
    const response = await fetch("/streetview/ai-review", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        imageId: window.imageId,
        mode: "review",
      }),
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.error || "Unable to generate AI review.");
    }

    aiReviewStatus.textContent = "Review complete.";
    aiReviewText.textContent = result.text;
    aiReviewButton.textContent = "Review Generated";
  } catch (error) {
    aiReviewStatus.textContent = error.message;
    aiReviewButton.disabled = false;
  }
});
```

Since the button now only exists on the results screen, remove the old `#aiReviewButton` logic from authentication code if `auth.js` currently enables or disables it.

