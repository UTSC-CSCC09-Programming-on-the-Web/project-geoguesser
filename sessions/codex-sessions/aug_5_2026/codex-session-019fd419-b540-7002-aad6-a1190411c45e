  <body>
    <header>
      <button class="secondary" onclick="previousLocation()">Previous</button>
      <button class="secondary" onclick="nextLocation()">Next</button>
      <button class="accept" onclick="setStatus('accepted')">Accept</button>
      <button class="change" onclick="setStatus('needs-change')">
        Needs Change
      </button>
      <button class="secondary" onclick="openMapillaryUrl()">
        Open in New Tab
      </button>
      <button class="secondary" onclick="exportReviewData()">
        Export Review JSON
      </button>
      <button class="danger" onclick="clearReviewData()">
        Clear Review Data
      </button>

      <div class="progress" id="progress"></div>
    </header>

    <main>
      <div id="location-container"></div>
    </main>

    <script src="review-locations.js"></script>

    <script>
      const STORAGE_KEY = "mapillary-location-review";
      let currentIndex = 0;

      const reviewData = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");

      if (!Array.isArray(window.locations)) {
        document.getElementById("location-container").innerHTML =
          "<p>Could not find window.locations in review-locations.js.</p>";
      } else {
        renderLocation();
      }

      function currentLocation() {
        return window.locations[currentIndex];
      }

      function currentReview() {
        const location = currentLocation();

        if (!reviewData[location.imageId]) {
          reviewData[location.imageId] = {
            status: "pending",
            note: "",
            replacementUrl: "",
          };
        }

        return reviewData[location.imageId];
      }

      function saveReviewData() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviewData));
      }

      function renderLocation() {
        const location = currentLocation();
        const review = currentReview();

        const cardClass = review.status;

        document.getElementById("progress").textContent =
          `${currentIndex + 1} / ${window.locations.length}`;

        document.getElementById("location-container").innerHTML = `
        <section class="location-card ${cardClass}">
          <h1>${escapeHtml(location.location)}</h1>

          <div class="metadata">
            <div><strong>Image ID:</strong> ${escapeHtml(location.imageId)}</div>
            <div><strong>Status:</strong> ${escapeHtml(review.status)}</div>
            <div><strong>Latitude:</strong> ${location.lat}</div>
            <div><strong>Longitude:</strong> ${location.lng}</div>
          </div>

          <div class="url">
            <strong>Mapillary URL:</strong><br />
            ${escapeHtml(location.url)}
          </div>

          <iframe
            class="mapillary-frame"
            src="${escapeAttribute(location.url)}"
            title="Mapillary streetview"
            allowfullscreen>
          </iframe>

          <label>
            Review notes:
            <textarea id="note">${escapeHtml(review.note)}</textarea>
          </label>

          <br />

          <label>
            Replacement URL, if needed:
            <textarea id="replacement-url">${escapeHtml(
              review.replacementUrl,
            )}</textarea>
          </label>

          <div class="actions">
            <button class="accept" onclick="setStatus('accepted')">
              Accept This Location
            </button>

            <button class="change" onclick="setStatus('needs-change')">
              Mark as Needing Change
            </button>
          </div>

          <div class="status">
            Review status is saved automatically in this browser.
          </div>
        </section>
      `;
      }

      function setStatus(status) {
        const review = currentReview();

        review.status = status;
        review.note = document.getElementById("note")?.value || "";
        review.replacementUrl =
          document.getElementById("replacement-url")?.value || "";

        saveReviewData();
        renderLocation();
      }

      function nextLocation() {
        saveCurrentTextFields();

        if (currentIndex < window.locations.length - 1) {
          currentIndex++;
          renderLocation();
        }
      }

      function previousLocation() {
        saveCurrentTextFields();

        if (currentIndex > 0) {
          currentIndex--;
          renderLocation();
        }
      }

      function saveCurrentTextFields() {
        const review = currentReview();

        review.note = document.getElementById("note")?.value || "";
        review.replacementUrl =
          document.getElementById("replacement-url")?.value || "";

        saveReviewData();
      }

      function openMapillaryUrl() {
        window.open(currentLocation().url, "_blank");
      }

      function exportReviewData() {
        saveCurrentTextFields();

        const output = window.locations.map((location) => ({
          ...location,
          reviewStatus: reviewData[location.imageId]?.status || "pending",
          reviewNote: reviewData[location.imageId]?.note || "",
          replacementUrl: reviewData[location.imageId]?.replacementUrl || "",
        }));

        const blob = new Blob([JSON.stringify(output, null, 2)], {
          type: "application/json",
        });

        const downloadUrl = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = downloadUrl;
        link.download = "mapillary-location-review.json";
        link.click();

        URL.revokeObjectURL(downloadUrl);
      }

      function clearReviewData() {
        if (
          confirm(
            "Clear all accepted, needs-change, and note data from this browser?",
          )
        ) {
          localStorage.removeItem(STORAGE_KEY);
          location.reload();
        }
      }

      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeAttribute(value) {
        return escapeHtml(value);
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") nextLocation();
        if (event.key === "ArrowLeft") previousLocation();
        if (event.key === "Enter" && event.ctrlKey) setStatus("accepted");
      });
    </script>
  </body>
</html>
```

